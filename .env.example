# Bybit Testnet API (нужны только для режима реальных тестовых ордеров, по умолчанию не используются)
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# Символ и таймфрейм
SYMBOL=DOGEUSDT
INTERVAL=5
# Стартовый виртуальный баланс каждого бота, USDT (11.98 ≈ 1000 ₽ по курсу ЦБ на 04.10.2026)
START_BALANCE=11.98
# Тот же старт в рублях: от него панель считает рублёвую доходность
START_RUB=1000
# Запасной курс ₽ за USDT, если ЦБ недоступен
RUB_PER_USDT=83.48
# Источник котировок: реальный спот Bybit (для тестнета — https://api-testnet.bybit.com)
BYBIT_BASE_URL=https://api.bybit.com
BYBIT_CATEGORY=spot
# Издержки за сторону сделки, %
FEE_PCT=0.1
SLIPPAGE_PCT=0.02
# Сумма одной сделки, USDT; 0 — минимальный ордер биржи
ORDER_USDT=0
# Интервал опроса рынка, мс
POLL_MS=60000
# Таймаут запроса к бирже, мс
BYBIT_TIMEOUT_MS=15000

# --- Авто-выбор лучшей ---
# Окно, за которое сравниваются стратегии, в свечах (288 × 5м = сутки)
META_WINDOW_CANDLES=288
# Насколько новый лидер должен обогнать текущего, чтобы его сменить, %
META_SWITCH_MARGIN_PCT=0.5

# --- Веб-панель ---
# Порт панели и адрес, на котором её публиковать (0.0.0.0 — на всех интерфейсах)
WEB_PORT=3004
WEB_BIND=0.0.0.0
# Ссылка на панель, подставляется в сообщения Telegram
WEB_PUBLIC_URL=

# --- Оповещения в Telegram ---
# Без токена и идентификатора чата оповещения просто не включаются.
# Токен берётся у @BotFather, идентификатор чата — у @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Сообщать о закрытой сделке начиная с этой доходности, %
TELEGRAM_MIN_PNL_PCT=3
# Час, после которого уходит ежедневная сводка (по времени контейнера)
TELEGRAM_DIGEST_HOUR=21
# Как часто проверять появление новых сделок, мс
NOTIFY_INTERVAL_MS=60000
